# =====PostgreSQL===== 
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_PORT=5432

# =====Ecommerce Service=====
ECOMMERCE_DB_URL=jdbc:postgresql://localhost:5432/ecommerce
ECOMMERCE_DB_USERNAME=ecommerce
ECOMMERCE_DB_PASSWORD=ecommerce

# =====Redis===== 
REDIS_PASSWORD=ecommerce
REDIS_PORT=6379

# =====Identity Service=====
# The Identity local Spring profile imports root .env when running from the repository root.
# Compose reads this file with --env-file; that does not configure a Spring process by itself.
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/identity
IDENTITY_DB_USERNAME=ecommerce
IDENTITY_DB_PASSWORD=ecommerce
IDENTITY_PORT=9000
IDENTITY_ISSUER=http://localhost:9000
# Place a valid RSA RS256 JWK set here; its active key must use the configured kid.
IDENTITY_JWK_SET_PATH=../../secrets/identity/signing-keys.jwks
IDENTITY_ACTIVE_KEY_ID=identity-local-dev
# Configure exact client callback URLs before using register-client.
IDENTITY_CLIENT_REDIRECT_URIS=
IDENTITY_CLIENT_POST_LOGOUT_REDIRECT_URIS=

# =====Media Service=====
MEDIA_DB_URL=jdbc:postgresql://localhost:5432/media
MEDIA_DB_USERNAME=ecommerce
MEDIA_DB_PASSWORD=ecommerce
MEDIA_PORT=9001
IDENTITY_JWK_SET_URI=http://localhost:9000/oauth2/jwks
MEDIA_AUDIENCE=media-api
MEDIA_DOWNLOAD_LINK_TTL=PT60S
MEDIA_PROVIDER_TIMEOUT=PT30S
# Cloudinary credentials are required to start Media outside tests. Keep real values out of Git.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ecommerce-media
CLOUDINARY_NOTIFICATION_URL=
CLOUDINARY_NOTIFICATION_KEY=
MEDIA_DIRECT_UPLOAD_ENABLED=false
MEDIA_DIRECT_UPLOAD_ISSUANCE_ENABLED=true
MEDIA_DIRECT_UPLOAD_WEBHOOK_ENABLED=false
MEDIA_CLEANUP_ENABLED=true
