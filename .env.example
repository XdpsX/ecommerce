# =====PostgreSQL===== 
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_PORT=5432

# =====Ecommerce Service=====
ECOMMERCE_DB_URL=jdbc:postgresql://localhost:5432/ecommerce
ECOMMERCE_DB_USERNAME=ecommerce
ECOMMERCE_DB_PASSWORD=ecommerce

# =====Redis===== 
REDIS_PASSWORD=ecommerce
REDIS_PORT=6379

# =====Identity Service=====
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/identity
IDENTITY_DB_USERNAME=ecommerce
IDENTITY_DB_PASSWORD=ecommerce
IDENTITY_PORT=9000
IDENTITY_ISSUER=http://localhost:9000
IDENTITY_BACKOFFICE_URL=http://localhost:3000
# Place a valid RSA RS256 JWK set here; its active key must use the configured kid.
IDENTITY_JWK_SET_PATH=../../secrets/identity/signing-keys.jwks
IDENTITY_ACTIVE_KEY_ID=identity-local-dev
# Configure exact client callback URLs before using register-client.
IDENTITY_CLIENT_ID=backoffice-bff
IDENTITY_CLIENT_NAME=Backoffice BFF
IDENTITY_CLIENT_REDIRECT_URIS=http://localhost:3000/login/oauth2/code/identity
IDENTITY_REFRESH_GRANT_ENABLED=false
# Intentionally empty: Backoffice uses local BFF logout, not Identity SSO logout.
IDENTITY_CLIENT_POST_LOGOUT_REDIRECT_URIS=

# =====Backoffice BFF=====
# Register the same confidential secret interactively in Identity
BFF_CLIENT_SECRET=local-dev-backoffice-client-secret-change-me
BFF_PORT=8081
BFF_PUBLIC_ORIGIN=http://localhost:3000
BFF_REDIS_HOST=localhost
BFF_REDIS_PORT=6379
BFF_REDIS_PASSWORD=ecommerce
BFF_ECOMMERCE_URI=http://localhost:8080

# =====Media Service=====
MEDIA_DB_URL=jdbc:postgresql://localhost:5432/media
MEDIA_DB_USERNAME=ecommerce
MEDIA_DB_PASSWORD=ecommerce
MEDIA_PORT=9001
IDENTITY_JWK_SET_URI=http://localhost:9000/oauth2/jwks
MEDIA_AUDIENCE=media-api
MEDIA_DOWNLOAD_LINK_TTL=PT60S
MEDIA_PROVIDER_TIMEOUT=PT30S
# They are not working credentials. Keep real values out of Git.
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
CLOUDINARY_FOLDER=ecommerce-media
# Media webhook URL (Cloudinary calls this directly, not through the Backoffice BFF).
# Replace this example with a public HTTPS host/tunnel forwarding to Media port 9001.
CLOUDINARY_NOTIFICATION_URL=https://media.example.test/api/media/cloudinary/notifications
CLOUDINARY_NOTIFICATION_KEY=replace-with-cloudinary-notification-key
# Keep disabled until direct-upload release verification; a URL alone does not enable it.
MEDIA_DIRECT_UPLOAD_ENABLED=false
MEDIA_DIRECT_UPLOAD_ISSUANCE_ENABLED=true
MEDIA_DIRECT_UPLOAD_WEBHOOK_ENABLED=false
MEDIA_CLEANUP_ENABLED=true
